{
  "name": "sql-cte-peek",
  "displayName": "SQL CTE Peek",
  "description": "Peek CTE bodies and dbt {{ ref('...') }} model files inline. Ctrl+Click to jump to definition.",
  "version": "0.2.0",
  "publisher": "joshkern",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshkern/sql-cte-peek"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.78.0"
  },
  "icon": "cte-peek.png",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sql",
    "cte",
    "peek",
    "snowflake",
    "definition"
  ],
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:snowflake-sql",
    "onLanguage:sql-mssql",
    "onLanguage:jinja-sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "SQL CTE Peek",
      "properties": {
        "sqlCtePeek.displayMode": {
          "type": "string",
          "enum": ["hover", "preview", "side-panel"],
          "enumDescriptions": [
            "Inline popup on hover (read-only)",
            "Read-only preview in a side panel",
            "Editable split editor scrolled to the reference target"
          ],
          "default": "side-panel",
          "description": "How to display previews."
        },
        "sqlCtePeek.triggerMode": {
          "type": "string",
          "enum": ["cte", "dbt", "both"],
          "enumDescriptions": [
            "Only CTE aliases trigger previews",
            "Only dbt {{ ref('...') }} model references trigger previews",
            "Both CTEs and dbt refs trigger previews"
          ],
          "default": "both",
          "description": "Which kinds of references trigger a preview."
        },
        "sqlCtePeek.maxNestingDepth": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of nested preview panels that can be opened when drilling into references."
        },
        "sqlCtePeek.hoverPreviewLines": {
          "type": "integer",
          "default": 50,
          "minimum": 5,
          "maximum": 500,
          "description": "Maximum lines of a dbt model file shown in hover previews."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npx tsx --test test/cteParser.test.ts",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.78.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "tsx": "^4.0.0",
    "@vscode/vsce": "^3.0.0"
  }
}
